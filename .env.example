# Copy to `.env` (project root while developing, or into the app's user-data folder when installed:
#   macOS: ~/Library/Application Support/Lyric Lens/.env )
# `.env` is git-ignored. Real environment variables always take precedence over this file.
# Nothing here is ever sent to the renderer process.

# ── Spotify ────────────────────────────────────────────────────────────────
# REQUIRED for live mode (or paste it in Settings → Spotify instead).
# Create an app at https://developer.spotify.com/dashboard, copy its Client ID.
# The app uses the PKCE flow, so NO client secret is needed or used.
SPOTIFY_CLIENT_ID=

# Must exactly match a Redirect URI registered on your Spotify app.
# Spotify requires the loopback IP literal (127.0.0.1), not "localhost".
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ── Lyrics ─────────────────────────────────────────────────────────────────
# Default provider is LRCLIB (free, synced lyrics, no key required).
LYRICS_PROVIDER=lrclib
# Only used by keyed providers you add yourself (unused by LRCLIB).
LYRICS_API_KEY=
# Optional: point at a self-hosted LRCLIB instance, e.g. http://localhost:3300/api
LYRICS_API_BASE_URL=

# ── Translation ────────────────────────────────────────────────────────────
# One of: deepl | google | openai   (you can also choose this in Settings → Translation)
TRANSLATION_PROVIDER=
# API key for the provider above. A key saved in Settings (stored in the macOS Keychain)
# takes precedence over this value.
TRANSLATION_API_KEY=
# openai only: chat model and (optional) OpenAI-compatible endpoint.
TRANSLATION_MODEL=gpt-4o-mini
TRANSLATION_API_BASE_URL=https://api.openai.com/v1

# ── Development ────────────────────────────────────────────────────────────
# 1 = simulated Spotify, lyrics and translation (no credentials needed).
LYRICLENS_DEMO=
# debug | info | warn | error   (default: debug in dev, info when packaged)
LOG_LEVEL=
